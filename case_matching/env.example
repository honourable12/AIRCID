# AI Case Matching Service Configuration

# Service Configuration
APP_NAME=AI Case Matching Service
APP_VERSION=1.0.0
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Matching Configuration
DEFAULT_MINIMUM_MATCH_SCORE=0.7
DEFAULT_CONFIDENCE_THRESHOLD=0.8
ENABLE_ML_MODELS=true
ENABLE_NLP_PROCESSING=true

# NLP Configuration
SPACY_MODEL=en_core_web_sm
NLP_CONFIDENCE_THRESHOLD=0.7
MAX_TEXT_LENGTH=10000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security Configuration
ENABLE_CORS=true
CORS_ORIGINS=["*"]

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# External Service Configuration
CENTRAL_BACKEND_URL=http://localhost:5000
EMR_INTEGRATION_URL=http://localhost:5001 